<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Uzum Tezkor</string>
    <key>CFBundleName</key>
    <string>uzum_tezkor_customer</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>CFBundleIdentifier</key>
    <string>uz.uzumtezkor.customer</string>

    <!-- GPS / xarita ruxsatlari (10-band) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Yaqin atrofdagi restoranlarni ko'rsatish va buyurtmangizni kuzatish uchun joylashuvingiz kerak</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Buyurtma yetkazib berilayotganda joylashuvingiz kerak bo'lishi mumkin</string>

    <!-- Avatar yuklash (2-band) -->
    <key>NSCameraUsageDescription</key>
    <string>Profil rasmi olish uchun kameraga ruxsat kerak</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Profil rasmini tanlash uchun galereyaga ruxsat kerak</string>

    <!-- Apple orqali kirish (3-band) -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>

    <!-- Google Maps API kaliti: AppDelegate.swift ichida GMSServices.provideAPIKey bilan ulanadi -->
    <key>GMSApiKey</key>
    <string>$(GOOGLE_MAPS_API_KEY)</string>

    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>uzumtezkor</string>
            </array>
        </dict>
    </array>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
</dict>
</plist>
