# Bu qiymatlar --dart-define orqali uzatiladi (pubspec .env fayl sifatida
# avtomatik o'qilmaydi). Masalan:
#
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:3000 \
#     --dart-define=SOCKET_URL=http://10.0.2.2:3000 \
#     --dart-define=GOOGLE_MAPS_API_KEY=AIza... \
#     --dart-define=GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

API_BASE_URL=http://10.0.2.2:3000
SOCKET_URL=http://10.0.2.2:3000
ENABLE_NETWORK_LOGS=true
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
